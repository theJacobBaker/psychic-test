/**
 * The inline React app for a single test. Reads window.PTC_TEST + window.PTC_SPECIALISTS.
 * Handles intro -> (quiz|cards) -> result with matched specialists and consult CTA.
 */
function ptc_engine_js() {
	$zener = ptc_zener_defs_js();
	return <<<JS
const { useState } = React;
const T = window.PTC_TEST;
const SPECIALISTS = window.PTC_SPECIALISTS || [];
const CONSULT = window.PTC_CONSULT || "/talk-to-a-psychic/";
$zener

function matchSpecialists(cats, limit){
  limit = limit || 2;
  const scored = SPECIALISTS.map(s => ({...s, _s: (s.cats||[]).filter(c => (cats||[]).indexOf(c) > -1).length}));
  scored.sort((a,b) => b._s - a._s);
  return scored.slice(0, limit);
}
function letterFor(i){ return ["A","B","C","D","E","F"][i]; }

function Intro({ onStart }){
  return (
    <section className="intro fade-in">
      <span className="eyebrow"><span className="dot"/>{T.eyebrow}</span>
      <h1 dangerouslySetInnerHTML={{__html: T.title.replace(/\\*(.+?)\\*/g,'<em>$1</em>')}}/>
      <p className="lede">{T.lede}</p>
      <button className="btn btn-primary" onClick={onStart}>Begin the test
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.8" strokeLinecap="round" strokeLinejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </button>
      <div className="intro-trust">
        <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.6" strokeLinecap="round"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>Anonymous</span>
        <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.6" strokeLinecap="round"><path d="M12 3l8 3v5c0 5-3.4 9.3-8 10-4.6-.7-8-5-8-10V6z"/></svg>No sign-up</span>
        <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.6" strokeLinecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>Instant result</span>
      </div>
    </section>
  );
}

function Question({ q, idx, total, value, onAnswer, onNext, onBack }){
  return (
    <section className="quiz fade-in" key={q.id}>
      <div className="step-num">Question {idx+1} of {total}</div>
      <h2 className="question" dangerouslySetInnerHTML={{__html: q.prompt.replace(/\\*(.+?)\\*/g,'<em>$1</em>')}}/>
      {q.sub ? <p className="question-sub">{q.sub}</p> : null}
      {q.type === "choice" && (
        <div className="options">
          {q.options.map((o,i) => (
            <button key={i} className={"option"+(value===i?" selected":"")} onClick={() => onAnswer(i)}>
              <span className="option-letter">{letterFor(i)}</span>
              <span className="option-label">{o.label}</span>
            </button>
          ))}
        </div>
      )}
      {q.type === "scale" && (
        <>
          <div className="scale">
            {[1,2,3,4,5,6,7].map(n => (
              <button key={n} className={"scale-pt"+(value===n?" selected":"")} onClick={() => onAnswer(n)}>{n}</button>
            ))}
          </div>
          <div className="scale-labels"><span>Not at all</span><span>Completely</span></div>
        </>
      )}
      <div className="nav-row">
        <button className="btn btn-ghost" onClick={onBack} style={{visibility: idx===0?"hidden":"visible"}}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.8"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>Previous
        </button>
        <button className="btn btn-primary" onClick={onNext} disabled={value===undefined}
          style={{opacity: value===undefined?0.4:1, pointerEvents: value===undefined?"none":"auto"}}>
          {idx===total-1 ? "See my result" : "Continue"}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.8"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </button>
      </div>
    </section>
  );
}

function Cards({ onDone }){
  const cfg = T.cards;
  const rounds = cfg.rounds;
  const [round, setRound] = useState(0);
  const [correct, setCorrect] = useState(0);
  const [target, setTarget] = useState(() => Math.floor(Math.random()*cfg.symbols.length));
  const [picked, setPicked] = useState(null); // index into symbols
  const revealed = picked !== null;
  const isHit = revealed && cfg.symbols[picked].k === cfg.symbols[target].k;

  function pick(i){
    if (revealed) return;
    setPicked(i);
    const hit = cfg.symbols[i].k === cfg.symbols[target].k;
    if (hit) setCorrect(c => c+1);
    setTimeout(() => {
      const next = round+1;
      if (next >= rounds){ onDone(hit?correct+1:correct, rounds); return; }
      setRound(next); setPicked(null); setTarget(Math.floor(Math.random()*cfg.symbols.length));
    }, 950);
  }

  const targetKey = cfg.symbols[target].k;
  return (
    <section className="cards-stage fade-in">
      <div className="container" style={{maxWidth:640}}>
        <div className="cards-top">
          <span className="cards-round">Round {round+1} of {rounds}</span>
          <span className="cards-score">{correct} sensed</span>
        </div>
        <div className={"cards-face"+(revealed?(" reveal "+(isHit?"correct":"wrong")):"")}>
          {revealed
            ? <span className="zener" dangerouslySetInnerHTML={{__html: ZENER[targetKey]}}/>
            : <span className="back">focus…</span>}
        </div>
        <div className={"cards-verdict "+(revealed?(isHit?"hit":"miss"):"")}>{revealed?(isHit?"A hit":"Not this time"):""}</div>
        <p className="question-sub" style={{textAlign:"center",margin:"0 auto 22px"}}>{cfg.prompt}<br/><span style={{color:"var(--ink-4)"}}>{cfg.sub}</span></p>
        <div className={"cards-choices"+(cfg.symbols.length===4?" n4":"")}>
          {cfg.symbols.map((s,i) => (
            <button key={i} className="choice-sym" disabled={revealed} onClick={() => pick(i)}>
              <span className="zener" dangerouslySetInnerHTML={{__html: ZENER[s.k]}}/>
              <span>{s.label}</span>
            </button>
          ))}
        </div>
      </div>
    </section>
  );
}

function computeArchetype(answers){
  const tally = {};
  T.questions.forEach(q => {
    const v = answers[q.id];
    if (v === undefined) return;
    if (q.type === "choice"){
      const tags = (q.options[v] && q.options[v].tags) || {};
      Object.keys(tags).forEach(k => { tally[k] = (tally[k]||0) + tags[k]; });
    }
  });
  let best = null, bestN = -1;
  Object.keys(T.results).forEach(k => { const n = tally[k]||0; if (n > bestN){ bestN = n; best = k; } });
  if (best === null) best = Object.keys(T.results)[0];
  return T.results[best];
}
function computeLevelPct(answers){
  let score = 0, max = 0;
  T.questions.forEach(q => {
    if (q.type === "choice"){
      max += 3;
      const v = answers[q.id];
      if (v !== undefined) score += (q.options[v] && q.options[v].pts) || 0;
    } else if (q.type === "scale"){
      max += 3;
      const v = answers[q.id];
      if (v !== undefined) score += Math.round(((v-1)/6)*3);
    }
  });
  return max ? Math.round((score/max)*100) : 0;
}
function levelForPct(pct){
  // levels are ordered high-min first
  for (let i=0;i<T.levels.length;i++){ if (pct >= T.levels[i].min) return T.levels[i]; }
  return T.levels[T.levels.length-1];
}

function Result({ result, note, onRestart }){
  const recs = matchSpecialists(result.cats, 2);
  return (
    <section className="result fade-in">
      <div className="result-eyebrow">Your result</div>
      <h2 className="result-title" dangerouslySetInnerHTML={{__html: "You are <em>"+result.name+".</em>"}}/>
      <p className="result-sub">{result.kicker}.</p>
      {note ? <p className="question-sub" style={{marginTop:-24}}>{note}</p> : null}

      <div className="archetype-card">
        <div className="archetype-header">
          <div className="archetype-glyph"/>
          <div>
            <h3 className="archetype-name">{result.name}</h3>
            <div className="archetype-kicker">{result.kicker}</div>
          </div>
        </div>
        <div className="archetype-body">{result.body.map((p,i) => <p key={i}>{p}</p>)}</div>
        <div className="traits">
          {Object.keys(result.traits).map(k => (
            <div key={k}><div className="trait-label">{k}</div><div className="trait-val">{result.traits[k]}</div></div>
          ))}
        </div>
      </div>

      <div className="recommend">
        <h3>Readers we'd suggest for you</h3>
        <p>Chosen from your result. Each has a strong record with exactly this.</p>
        <div className="rec-grid">
          {recs.map(p => (
            <a key={p.id} className="rec-card" href={CONSULT}>
              <div className="rec-photo" style={{backgroundImage:"url("+p.photo+")"}}/>
              <div className="rec-body"><div className="rec-name">{p.name}</div><div className="rec-meta">{p.meta}</div></div>
              <div className="rec-match">Great fit</div>
            </a>
          ))}
        </div>
      </div>

      <div className="result-cta">
        <div className="result-cta-text">
          <h4>Talk it through with a specialist.</h4>
          <p>Your first few minutes are free. Start a reading with a matched reader — end anytime, no charge if it isn't right.</p>
        </div>
        <a className="btn btn-primary" href={CONSULT}>Talk to a specialist
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.8" strokeLinecap="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      </div>

      <div className="result-more">
        <button className="btn btn-ghost" onClick={onRestart}>Retake the test</button>
        <div style={{marginTop:10}}>Or <a href="/">try another test</a>.</div>
      </div>
    </section>
  );
}

function App(){
  const [stage, setStage] = useState("intro"); // intro | quiz | cards | result
  const [idx, setIdx] = useState(0);
  const [answers, setAnswers] = useState({});
  const [finished, setFinished] = useState(null); // {result, note}

  const start = () => setStage(T.engine === "cards" ? "cards" : "quiz");

  function onAnswer(v){ setAnswers(a => ({...a, [T.questions[idx].id]: v})); }
  function onNext(){
    if (idx === T.questions.length-1){ finishQuiz(); }
    else setIdx(idx+1);
  }
  function onBack(){ setIdx(Math.max(0, idx-1)); }

  function finishQuiz(){
    if (T.mode === "archetype"){ setFinished({result: computeArchetype(answers)}); }
    else {
      const pct = computeLevelPct(answers);
      setFinished({result: levelForPct(pct)});
    }
    setStage("result");
  }
  function onCardsDone(correct, rounds){
    const pct = Math.round((correct/rounds)*100);
    setFinished({result: levelForPct(pct), note: "You sensed "+correct+" of "+rounds+" ("+pct+"%). Pure chance is about "+(T.cards.chance)+"%."});
    setStage("result");
  }

  const q = T.questions ? T.questions[idx] : null;
  const val = q ? answers[q.id] : undefined;
  const total = T.questions ? T.questions.length : 0;
  const pct = stage==="result" ? 100 : (stage==="quiz" ? ((idx+1)/total)*100 : (stage==="cards"?50:0));

  return (
    <>
      <header className="header">
        <div className="container header-inner">
          <a className="logo" href="/"><span className="logo-mark"/>Psychic Test</a>
          <nav className="header-nav">
            <a href="/">All tests</a>
            <a href={CONSULT} className="btn btn-secondary">Talk to a psychic</a>
          </nav>
        </div>
      </header>

      {stage !== "intro" && (
        <div className="progress-wrap"><div className="container">
          <div className="progress-label">
            <span>{stage==="result" ? "Complete" : (stage==="cards" ? "In progress" : "Question "+(idx+1)+" / "+total)}</span>
            <span>{Math.round(pct)}%</span>
          </div>
          <div className="progress-bar"><div className="progress-fill" style={{width: pct+"%"}}/></div>
        </div></div>
      )}

      <main className="container">
        {stage==="intro" && <Intro onStart={start}/>}
        {stage==="quiz" && <Question q={q} idx={idx} total={total} value={val} onAnswer={onAnswer} onNext={onNext} onBack={onBack}/>}
      </main>
      {stage==="cards" && <Cards onDone={onCardsDone}/>}
      <main className="container">
        {stage==="result" && finished && <Result result={finished.result} note={finished.note} onRestart={() => {setStage("intro");setIdx(0);setAnswers({});setFinished(null);}}/>}
      </main>

      <footer className="footer container">
        <span>© 2026 Psychic Test · For entertainment & self-reflection</span>
        <span>Anonymous · No sign-up · Answers aren't stored</span>
      </footer>
    </>
  );
}

ReactDOM.createRoot(document.getElementById("root")).render(<App/>);
JS;
