/** Look up specialists whose categories match any of $cats, best matches first. Returns up to $limit. */
function ptc_match_specialists( $cats, $limit = 2 ) {
	$cats = (array) $cats;
	$scored = array();
	foreach ( ptc_specialists() as $s ) {
		$overlap = count( array_intersect( $cats, $s['cats'] ) );
		if ( $overlap > 0 ) {
			$s['_score'] = $overlap;
			$scored[] = $s;
		}
	}
	usort( $scored, function ( $a, $b ) { return $b['_score'] - $a['_score']; } );
	if ( count( $scored ) < $limit ) {
		// pad with any specialists not already included
		foreach ( ptc_specialists() as $s ) {
			$have = false;
			foreach ( $scored as $x ) { if ( $x['id'] === $s['id'] ) { $have = true; break; } }
			if ( ! $have ) { $scored[] = $s; }
			if ( count( $scored ) >= $limit ) break;
		}
	}
	return array_slice( $scored, 0, $limit );
}
